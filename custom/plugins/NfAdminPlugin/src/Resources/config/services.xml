<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- Subscribers -->
        <service id="Nf\AdminPlugin\Storefront\Subscriber\ProductSubscriber">
            <argument type="service" id="Nf\AdminPlugin\Service\ProductService"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nf\AdminPlugin\Storefront\Subscriber\FlowSubscriber">
            <argument type="service" id="user.repository"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Services -->
        <service id="Nf\AdminPlugin\Service\ProductService">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
        </service>

        <!--Decorators -->
        <service id="Nf\AdminPlugin\Decorator\ProductGatewayDecorator" decorates="Shopware\Core\Content\Product\Cart\ProductGateway">
              <argument type="service" id="Nf\AdminPlugin\Decorator\ProductGatewayDecorator.inner" />
            <argument type="service" id="Nf\AdminPlugin\Service\ProductService"/>
        </service>

        <!--Twig -->
        <service id="Nf\AdminPlugin\Twig\Extension\MediaUrlExtension">
            <argument type="service" id="media.repository"/>

            <tag name="twig.extension"/>
        </service>

        <!--Rule -->
<!--        <service id="Nf\AdminPlugin\Core\Content\Flow\Rule\OrderCreatedByAdminRoleRule">-->
<!--            <tag name="shopware.rule.definition"/>-->
<!--        </service>-->

    </services>
</container>
