{% block block_two_column_3_9 %}
    {% block block_two_column_3_9_left %}
        {% set element = block.slots.getSlot('left') %}

        <div class="col-12 col-md-6" data-cms-element-id="{{ element.id }}">
            {% block block_two_column_3_9_left_inner %}
                {% sw_include "@Storefront/storefront/element/cms-element-" ~ element.type ~ ".html.twig" ignore missing %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block block_two_column_3_9_right %}
        {% set element = block.slots.getSlot('right') %}

        <div class="col-12 col-md-6" data-cms-element-id="{{ element.id }}">
            {% block block_two_column_3_9_right_inner %}
                {% sw_include "@Storefront/storefront/element/cms-element-" ~ element.type ~ ".html.twig" ignore missing %}
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}