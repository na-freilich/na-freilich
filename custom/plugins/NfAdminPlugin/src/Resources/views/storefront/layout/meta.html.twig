{% sw_extends '@Storefront/storefront/layout/meta.html.twig' %}

{% block layout_head_meta_tags %}
    {% sw_include '@AdminPlugin/storefront/layout/gtm_head.html.twig' %}
    {{ parent() }}

    {% set markerIoEnabled = config('AdminPlugin.config.markerIoEnabled') %}
    {% set markerIoProject = config('AdminPlugin.config.markerIoProject')|trim %}
    {% set externalConsent = config('AdminPlugin.config.externalConsent') %}

    {% if markerIoEnabled and markerIoProject %}
        <script>
            (function () {
                var cookieName = 'nf-marker-io-enabled';
                var project = '{{ markerIoProject|e('js') }}';
                var externalConsent = {{ externalConsent ? 'true' : 'false' }};

                function hasConsent() {
                    if (externalConsent) {
                        return true;
                    }

                    return document.cookie.split(';').some(function (item) {
                        return item.trim() === cookieName + '=1';
                    });
                }

                function loadMarker() {
                    if (window.__nfMarkerLoaded || !hasConsent()) {
                        return;
                    }

                    window.__nfMarkerLoaded = true;
                    window.markerConfig = {
                        project: project,
                        source: 'snippet'
                    };

                    !function (e, r) {
                        if (e.__Marker) {
                            return;
                        }
                        e.__Marker = {};
                        var t = [], n = {__cs: t};
                        ["show", "hide", "isVisible", "capture", "cancelCapture", "unload", "reload", "isExtensionInstalled", "setReporter", "clearReporter", "setCustomData", "on", "off"].forEach(function (name) {
                            n[name] = function () {
                                var args = Array.prototype.slice.call(arguments);
                                args.unshift(name);
                                t.push(args);
                            };
                        });
                        e.Marker = n;
                        var s = r.createElement("script");
                        s.async = 1;
                        s.src = "https://edge.marker.io/latest/shim.js";
                        var i = r.getElementsByTagName("script")[0];
                        i.parentNode.insertBefore(s, i);
                    }(window, document);
                }

                function watchConsent() {
                    if (externalConsent || !document.$emitter) {
                        return;
                    }

                    document.$emitter.subscribe('CookieConfiguration_Update', function () {
                        loadMarker();
                    });
                }

                if (hasConsent()) {
                    loadMarker();
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', watchConsent);
                } else {
                    watchConsent();
                }
            })();
        </script>
    {% endif %}
{% endblock %}
