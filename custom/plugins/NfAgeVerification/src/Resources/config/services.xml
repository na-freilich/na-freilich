<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="NfAgeVerification\Service\CustomFieldService" public="true">
            <argument type="service" id="custom_field_set.repository"/>
        </service>

        <service id="NfAgeVerification\Checkout\Cart\AgeVerificationGuard">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="request_stack"/>
        </service>

        <service id="NfAgeVerification\Checkout\Cart\AgeRestrictionCartProcessor">
            <argument type="service" id="NfAgeVerification\Checkout\Cart\AgeVerificationGuard"/>
            <tag name="shopware.cart.processor" priority="-1000"/>
        </service>

        <service id="NfAgeVerification\Checkout\Cart\AgeRestrictionCartValidator">
            <argument type="service" id="NfAgeVerification\Checkout\Cart\AgeVerificationGuard"/>
            <tag name="shopware.cart.validator"/>
        </service>
    </services>
</container>
