{% block nf_booking_product_cart_credit %}
    {% if context.customer is not null and context.customer.guest == false %}
        <div data-nf-booking-credit="true">
        {% if booking.totalCreditSlots > 0 %}
            <div class="nf-booking-cart-widget applied-credit mt-4 pt-3 pb-3 mb-3 border-primary"
                >

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="h6 mb-1 font-weight-bold text-dark">
                            {{ "nfBooking.credit.appliedTitle"|trans|sw_sanitize }}
                        </h4>
                        <p class="small text-success mb-0">
                            <strong>{{ booking.totalCreditSlots|number_format(1, ',', '.') }} {{ "nfBooking.credit.unit"|trans|sw_sanitize }}</strong>
                            {{ "nfBooking.credit.willBeUsed"|trans|sw_sanitize }}
                        </p>
                    </div>

                    <div class="col-4">
                        <button type="submit"
                                id="remove-credit-button"
                                class="btn btn-outline-danger btn-sm btn-block font-weight-bold">
                            {{ "nfBooking.credit.removeButton"|trans|sw_sanitize }}
                        </button>
                    </div>
                </div>
            </div>
        {% else %}


            {% set availableSlots = customerCredit|default(0) %}

            {% if availableSlots > 0 %}
                <div class="nf-booking-cart-widget mt-4 pt-3 pb-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="h6 mb-0 font-weight-bold text-dark">
                            {{ "nfBooking.credit.creditTitle"|trans|sw_sanitize }}
                        </h4>
                        <span class="badge badge-pill badge-light border text-primary px-2 py-1">
                            {{ "nfBooking.credit.availableBadge"|trans({'%count%': availableSlots})|sw_sanitize }}
                        </span>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="col-7">
                            <select class="custom-select custom-select-sm" name="nf-booking-slots-usage">
                                <option value="0" selected>
                                    {{ "nfBooking.credit.dontUse"|trans|sw_sanitize }}
                                </option>

                                {% set limit = (min(availableSlots, slotCount) * 10)|round(0, 'floor') %}
                                {% for i in range(5, limit, 5) %}
                                    {% set val = i / 10 %}
                                    <option value="{{ val }}">
                                        {{ val|number_format(1, ',', '.') }} {{ "nfBooking.credit.unit"|trans|sw_sanitize }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="col-5">
                            <button
                                    id="apply-credit-button"
                                    type="submit"
                                    class="btn btn-primary btn-sm btn-block font-weight-bold"
                                    disabled>
                                {{ "nfBooking.credit.applyButton"|trans|sw_sanitize }}
                            </button>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}
        </div>
    {% endif %}
{% endblock %}