{% block sw_cms_block_order_summary_preview %}
    <div class="sw-cms-preview-order-summary">
        <div class="preview-card">
            <div class="skeleton-bar title"></div>

            <div class="preview-item">
                <div class="skeleton-bar label"></div>
                <div class="skeleton-bar price"></div>
            </div>
            <div class="preview-item">
                <div class="skeleton-bar label-short"></div>
                <div class="skeleton-bar price"></div>
            </div>

            <hr class="preview-divider">

            <div class="preview-item total">
                <div class="skeleton-bar label-bold"></div>
                <div class="skeleton-bar price-bold"></div>
            </div>

            <div class="preview-item">
                <div class="skeleton-bar label-extra-short"></div>
                <div class="skeleton-bar price-short"></div>
            </div>
            <div class="preview-item">
                <div class="skeleton-bar label-extra-short"></div>
                <div class="skeleton-bar price-short"></div>
            </div>
        </div>
    </div>
{% endblock %}