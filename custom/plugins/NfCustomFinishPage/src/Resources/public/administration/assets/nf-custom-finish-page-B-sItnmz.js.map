{% block sw_cms_el_preview_order_progress %}
    <div class="sw-cms-el-preview-order-progress">
        <div class="sw-cms-el-preview-order-progress-inner">
            <div class="preview-step completed">
                <span class="icon">✓</span>
            </div>
            <div class="preview-line completed"></div>
            <div class="preview-step active">
                <span class="icon">2</span>
            </div>
            <div class="preview-line"></div>
            <div class="preview-step">
                <span class="icon">3</span>
            </div>
            <div class="preview-line"></div>
            <div class="preview-step">
                <span class="icon">4</span>
            </div>
        </div>
        <p class="preview-text">Fortschritts-Anzeige</p>
    </div>
{% endblock %}