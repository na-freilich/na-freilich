{% block sw_cms_block_order_newsletter_preview %}
    <div class="sw-cms-preview-order-newsletter">
        <div class="preview-body">
            <div class="preview-info">
                <h6>{{ $t('sw-cms.elements.order-newsletter.title') }}</h6>
                <div class="preview-check-list">
                    <div class="check-item">✓{{ $t('sw-cms.elements.order-newsletter.item1') }}</div>
                    <div class="check-item">✓{{ $t('sw-cms.elements.order-newsletter.item2') }}</div>
                </div>
            </div>
            <div class="preview-actions">
                <div class="preview-input-mock">user@beispiel.de</div>
                <div class="preview-btn-mock">{{ $t('sw-cms.elements.order-newsletter.buttonLabel') }}</div>
            </div>
        </div>
    </div>
{% endblock %}