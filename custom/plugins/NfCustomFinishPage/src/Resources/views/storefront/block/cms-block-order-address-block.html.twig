{% block cms_block_order_address %}
    <div class="cms-block-order-address">
        {% set element = block.slots.getSlot('addressContent') %}
        {% if element %}
            {% sw_include "@Storefront/storefront/element/cms-element-" ~ element.type ~ ".html.twig" with {
                element: element
            } %}
        {% endif %}
    </div>
{% endblock %}