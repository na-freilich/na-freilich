{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{% block buy_widget_price %}
    {% if product.extensions.upsell_active %}
        {% set upsell = product.extensions.upsell_active %}

        <div class="upsell-timer-wrapper card mb-3 border-0 shadow-sm"
             style="background-color: #fff5e6; border-radius: 12px; overflow: hidden;">
            <div class="card-body p-3 text-center"
                 data-nf-upselling-timer="true"
                 data-expires-at="{{ upsell.endedAt|date('c') }}"
            >

                <div class="h6 mb-2 font-weight-bold text-dark">
                    {{ 'nf-upsell-timer.product.title'|trans|sw_sanitize }}
                </div>

                <div class="d-flex align-items-center justify-content-center">
                    <div class="timer-display-box d-inline-flex align-items-center px-3 py-1"
                         style="background: rgba(255,255,255,0.5); border-radius: 20px;">

                        {% sw_icon 'clock' style { 'size': '16', 'class': 'text-warning me-2' } %}

                        <span class="timer-text-label me-2" style="font-size: 0.9rem; color: #555;">
                            {{ 'nf-upsell-timer.product.remaining'|trans|sw_sanitize }}
                        </span>
                        <span class="js-timer-display font-weight-bold text-danger"
                              style="font-family: 'Courier New', Courier, monospace; font-size: 1.1rem;">
                            00:00
                        </span>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {{ parent() }}
{% endblock %}