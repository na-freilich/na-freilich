{% block cms_element_order_summary %}

    {% set order = page.order %}
    {% if order %}
        <div class="cms-order-summary-wrapper">
            <div class="checkout-aside-summary">
                <h2 class="checkout-aside-summary-header">
                    {{ 'checkout.summaryHeader'|trans|sw_sanitize }}
                </h2>
                <div class="checkout-aside-summary-list-container">
                    {% sw_include '@Storefront/storefront/page/checkout/summary.html.twig' with {
                        summary: order.price
                    } %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}