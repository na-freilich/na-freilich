<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Nf\DynamicProductBadges\Core\Content\ProductBadge\CustomProductBadgeDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Nf\DynamicProductBadges\Core\Content\ProductBadge\CustomProductBadgeProductDefinition">
            <tag name="shopware.entity.definition" entity="nf_custom_badge_product" />
        </service>

        <service id="Nf\DynamicProductBadges\Core\Content\Product\Extension\ProductCustomBadgeExtension">
            <tag name="shopware.entity.extension"/>
        </service>
    </services>

</container>
