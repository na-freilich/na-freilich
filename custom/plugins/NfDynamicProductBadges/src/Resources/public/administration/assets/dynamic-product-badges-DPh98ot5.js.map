{% block nf_product_badge_add %}
    <sw-page class="nf-product-badge-add">
        <template #smart-bar-header>
            <h2 v-if="entity && entity.name">{{ entity.name }}</h2>
        </template>

        <template #smart-bar-actions>
            <sw-button :disabled="!entity.name" variant="primary"
                       v-on:click="onSave">
                {{ $tc('nf-product-badge.common.actions.save') }}
            </sw-button>
        </template>

        <template #content>
            <sw-card-view v-if="!isLoading">
                <sw-card>
                    <sw-container columns="2fr 2fr 1fr" gap="20px">
                        <sw-text-field
                                v-model:value="entity.name"
                                :placeholder="$tc('nf-product-badge.common.placeholders.name')"
                                required
                                :label="$tc('nf-product-badge.common.labels.name')">
                        </sw-text-field>

                        <sw-text-field
                                v-model:value="entity.text"
                                :placeholder="$tc('nf-product-badge.common.placeholders.text')"
                                required
                                :label="$tc('nf-product-badge.common.labels.text')">
                        </sw-text-field>

                        <sw-colorpicker
                                v-model:value="entity.color"
                                :label="$tc('nf-product-badge.common.labels.color')"
                                color-output="hex"
                        />

                    </sw-container>

                </sw-card>
            </sw-card-view>
            <sw-loader v-else></sw-loader>
        </template>
    </sw-page>
{% endblock %}
