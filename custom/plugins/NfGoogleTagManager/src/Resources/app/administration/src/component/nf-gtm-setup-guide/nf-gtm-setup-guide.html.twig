<div class="nf-gtm-setup-guide">
    <div class="nf-gtm-setup-guide__banner">
        <strong>{{ texts.bannerTitle }}</strong>
        <p>{{ texts.bannerBody }}</p>
    </div>

    <h3 class="nf-gtm-setup-guide__heading">{{ texts.shopTitle }}</h3>
    <ol class="nf-gtm-setup-guide__list">
        <li>{{ texts.shop1 }}</li>
        <li>{{ texts.shop2 }}</li>
        <li>{{ texts.shop3 }}</li>
    </ol>

    <h3 class="nf-gtm-setup-guide__heading">{{ texts.importTitle }}</h3>
    <ol class="nf-gtm-setup-guide__list">
        <li>{{ texts.import1 }}</li>
        <li>{{ texts.import2 }}</li>
        <li>{{ texts.import3 }}</li>
        <li>{{ texts.import4 }}</li>
        <li>{{ texts.import5 }}</li>
        <li>{{ texts.import6 }}</li>
    </ol>

    <p>
        <a class="nf-gtm-setup-guide__download"
           :href="jsonUrl"
           download="ga4-container.json">
            {{ texts.download }}
        </a>
    </p>

    <h3 class="nf-gtm-setup-guide__heading">{{ texts.afterTitle }}</h3>
    <ol class="nf-gtm-setup-guide__list">
        <li>{{ texts.after1 }}</li>
        <li>{{ texts.after2 }}</li>
        <li>{{ texts.after3 }}</li>
        <li>{{ texts.after4 }}</li>
        <li>{{ texts.after5 }}</li>
    </ol>

    <h3 class="nf-gtm-setup-guide__heading">{{ texts.ga4Title }}</h3>
    <ol class="nf-gtm-setup-guide__list">
        <li>{{ texts.ga41 }}</li>
        <li>{{ texts.ga42 }}</li>
        <li>{{ texts.ga43 }}</li>
    </ol>
</div>
