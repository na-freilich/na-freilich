<?xml version="1.0" encoding="UTF-8"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>Google Tag Manager Settings</title>
        <title lang="de-DE">Google Tag Manager Einstellungen</title>

        <input-field type="text">
            <name>gtmId</name>
            <label>GTM Container ID</label>
            <label lang="de-DE">GTM Container-ID</label>
            <placeholder>GTM-XXXXXXX</placeholder>
            <helpText>Container for this shop. Events are pushed to the dataLayer. Import src/Resources/gtm/ga4-container.json into that container and set the GA4 measurement id there. See README.md.</helpText>
            <helpText lang="de-DE">Container dieses Shops. Ereignisse werden in den dataLayer geschrieben. src/Resources/gtm/ga4-container.json in diesen Container importieren und dort die GA4-Measurement-ID setzen. Siehe README.md.</helpText>
        </input-field>

        <input-field type="bool">
            <name>active</name>
            <label>Activate Tracking</label>
            <label lang="de-DE">Tracking aktivieren</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>debugMode</name>
            <label>Enable Debug Mode (Console logs)</label>
            <label lang="de-DE">Debugging-Protokollierung (console.log aktivieren))</label>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Consent Mode v2 Settings</title>
        <title lang="de-DE">Consent Mode v2 Einstellungen</title>

        <input-field type="bool">
            <name>consentModeEnabled</name>
            <label>Enable Consent Mode v2 Default (denied)</label>
            <label lang="de-DE">Consent Mode v2 Default aktivieren (denied)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>externalConsent</name>
            <label>Consent is managed externally</label>
            <label lang="de-DE">Einwilligung wird extern verwaltet</label>
            <helpText>Loads Google Tag Manager without waiting for the Shopware statistics cookie. Enable only when an external consent tool already blocks this script.</helpText>
            <helpText lang="de-DE">Lädt Google Tag Manager, ohne auf das Shopware-Statistik-Cookie zu warten. Nur aktivieren, wenn ein externes Consent-Tool dieses Skript bereits blockiert.</helpText>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Supported E-Commerce Events</title>
        <title lang="de-DE">Unterstützte E-Commerce Events</title>

        <input-field type="bool">
            <name>eventViewItemList</name>
            <label>Track view_item_list (Category / Listing)</label>
            <label lang="de-DE">view_item_list tracken (Kategorie / Listing)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventViewItem</name>
            <label>Track view_item (Product Detail Page)</label>
            <label lang="de-DE">view_item tracken (Produktdetailseite)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventAddToCart</name>
            <label>Track add_to_cart (AJAX Button Click)</label>
            <label lang="de-DE">add_to_cart tracken (AJAX Klick)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventPurchase</name>
            <label>Track purchase (Order Confirmation Page)</label>
            <label lang="de-DE">purchase tracken (Bestellbestätigung)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventSelectItem</name>
            <label>Track select_item (Product clicks in listing)</label>
            <label lang="de-DE">select_item tracken (Klicks im Listing)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventViewCart</name>
            <label>Track view_cart (Cart page / Off-canvas)</label>
            <label lang="de-DE">view_cart tracken (Warenkorb / Off-Canvas)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventRemoveFromCart</name>
            <label>Track remove_from_cart (Delete item)</label>
            <label lang="de-DE">remove_from_cart tracken (Artikel löschen)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventCheckoutSteps</name>
            <label>Track add_shipping_info / add_payment_info</label>
            <label lang="de-DE">add_shipping_info / add_payment_info tracken</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventAddToWishlist</name>
            <label>Track add_to_wishlist (Wishlist click)</label>
            <label lang="de-DE">add_to_wishlist tracken (Merkzettel Klick)</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>eventSearch</name>
            <label>Track search (Internal site search)</label>
            <label lang="de-DE">search tracken (Interne Suche)</label>
            <defaultValue>true</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Item properties</title>
        <title lang="de-DE">Artikeleigenschaften</title>

        <input-field type="text">
            <name>itemPropertyParameter1</name>
            <label>Data layer field 1</label>
            <label lang="de-DE">Data-Layer-Feld 1</label>
            <placeholder>item_category2</placeholder>
            <helpText>Item field name for this shop. Letters, numbers and underscores. Example: item_category2 or size. Leave empty to skip this slot.</helpText>
            <helpText lang="de-DE">Feldname im Item für diesen Shop. Buchstaben, Zahlen und Unterstriche. Beispiel: item_category2 oder size. Leer lassen, um diesen Platz zu überspringen.</helpText>
        </input-field>
        <component name="sw-entity-single-select">
            <name>itemPropertyGroup1</name>
            <entity>property_group</entity>
            <label>Property group 1</label>
            <label lang="de-DE">Eigenschaftsgruppe 1</label>
            <helpText>Shopware property group copied into data layer field 1.</helpText>
            <helpText lang="de-DE">Shopware-Eigenschaftsgruppe, die in Data-Layer-Feld 1 übernommen wird.</helpText>
        </component>

        <input-field type="text">
            <name>itemPropertyParameter2</name>
            <label>Data layer field 2</label>
            <label lang="de-DE">Data-Layer-Feld 2</label>
            <placeholder>item_category3</placeholder>
        </input-field>
        <component name="sw-entity-single-select">
            <name>itemPropertyGroup2</name>
            <entity>property_group</entity>
            <label>Property group 2</label>
            <label lang="de-DE">Eigenschaftsgruppe 2</label>
        </component>

        <input-field type="text">
            <name>itemPropertyParameter3</name>
            <label>Data layer field 3</label>
            <label lang="de-DE">Data-Layer-Feld 3</label>
            <placeholder>item_category4</placeholder>
        </input-field>
        <component name="sw-entity-single-select">
            <name>itemPropertyGroup3</name>
            <entity>property_group</entity>
            <label>Property group 3</label>
            <label lang="de-DE">Eigenschaftsgruppe 3</label>
        </component>

        <input-field type="text">
            <name>itemPropertyParameter4</name>
            <label>Data layer field 4</label>
            <label lang="de-DE">Data-Layer-Feld 4</label>
            <placeholder>item_category5</placeholder>
        </input-field>
        <component name="sw-entity-single-select">
            <name>itemPropertyGroup4</name>
            <entity>property_group</entity>
            <label>Property group 4</label>
            <label lang="de-DE">Eigenschaftsgruppe 4</label>
        </component>
    </card>
</config>
