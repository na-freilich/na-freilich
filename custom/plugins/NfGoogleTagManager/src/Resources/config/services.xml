<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <service id="NfGoogleTagManager\Components\DataLayerMapper"/>

        <service id="NfGoogleTagManager\Components\ItemPropertyMap"/>

        <service id="NfGoogleTagManager\Components\BeginCheckoutTracker"/>

        <service id="NfGoogleTagManager\Storefront\Twig\GtmTwigExtension">
            <tag name="twig.extension"/>
        </service>

        <service id="NfGoogleTagManager\Subscriber\DataLayerSubscriber">
            <argument key="$productRepository" type="service" id="sales_channel.product.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NfGoogleTagManager\Subscriber\CookieSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

    </services>
</container>