{% sw_extends '@Storefront/storefront/component/checkout/offcanvas-cart.html.twig' %}

{% block component_offcanvas_cart_hidden_line_items_information %}
    {{ parent() }}

    {% set salesChannelId = context.salesChannelId %}

    {% if config('NfGoogleTagManager.config.active', salesChannelId)
        and config('NfGoogleTagManager.config.eventViewCart', salesChannelId)
        and page.extensions.nfGtmCartItems is defined
        and page.extensions.nfGtmCartItems %}
        <input type="hidden"
               id="js-nf-gtm-offcanvas-data"
               data-nf-cart-value="{{ page.extensions.nfGtmCartItems.all.ecommerce.value|default(0) }}"
               data-nf-cart-items="{{ page.extensions.nfGtmCartItems.all.ecommerce.items|default([])|json_encode|escape('html_attr') }}">
    {% endif %}
{% endblock %}
