{% sw_extends '@Storefront/storefront/component/line-item/type/product.html.twig' %}

{% block component_line_item_type_product_row_inner %}
    {% set salesChannelId = context.salesChannelId %}
    {% set trackRemove = config('NfGoogleTagManager.config.active', salesChannelId) and config('NfGoogleTagManager.config.eventRemoveFromCart', salesChannelId) %}

    {% if trackRemove %}
        {% set trackedItems = [] %}
        {% if page.extensions.nfGtmCartItems is defined and page.extensions.nfGtmCartItems %}
            {% set trackedItems = page.extensions.nfGtmCartItems.all.ecommerce.items|default([]) %}
        {% elseif page.extensions.nfGtmDataLayer is defined and page.extensions.nfGtmDataLayer.all.ecommerce.items is defined %}
            {% set trackedItems = page.extensions.nfGtmDataLayer.all.ecommerce.items %}
        {% endif %}

        {% set trackedItem = null %}
        {% for item in trackedItems %}
            {% if item.item_id == lineItem.payload.productNumber|default(lineItem.referencedId) %}
                {% set trackedItem = item %}
            {% endif %}
        {% endfor %}

        {% if trackedItem is null %}
            {% set trackedItem = {
                item_id: lineItem.payload.productNumber|default(lineItem.referencedId),
                item_name: lineItem.label,
                price: lineItem.price.unitPrice|default(0),
                quantity: lineItem.quantity
            } %}
        {% endif %}

        <input type="hidden"
               class="js-nf-gtm-track-item"
               data-nf-gtm-item="{{ trackedItem|json_encode|escape('html_attr') }}">
    {% endif %}

    {{ parent() }}
{% endblock %}
