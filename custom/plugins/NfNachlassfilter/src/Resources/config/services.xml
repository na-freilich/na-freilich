<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Subscriber -->
        <service id="Nf\NachlassFilter\Storefront\Subscriber\ListingSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service"
                      id="Nf\NachlassFilter\Service\FilterService" />
        </service>

        <!-- Service -->
        <service id="Nf\NachlassFilter\Service\FilterService" public="true">
            <argument type="service"
                      id="Shopware\Core\System\SystemConfig\SystemConfigService" />
        </service>

        <!-- Decorates -->
        <service id="Nf\NachlassFilter\Core\Content\Product\Cms\NachlassProductListingCmsElementResolver"
                 decorates="Shopware\Core\Content\Product\Cms\ProductListingCmsElementResolver">
            <argument type="service"
                      id="Nf\NachlassFilter\Core\Content\Product\Cms\NachlassProductListingCmsElementResolver.inner" />
        </service>

    </services>
</container>
