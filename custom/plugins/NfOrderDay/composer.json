{
    "name": "nf/order-day",
    "description": "Nf Order day",
    "type": "shopware-platform-plugin",
    "version": "1.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "na freilich GmbH",
            "homepage": "https://www.na-freilich.de/"
        }
    ],
    "require": {
        "shopware/core": ">=6.7"
    },
    "extra": {
